<Window x:Class="WPFVideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Видео-плеер" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="btnSelectFile" Content="Выбрать файл" Width="100" Margin="5" Click="btnSelectFile_Click"/>
            <Button x:Name="btnPlay" Content="Проирать" Width="100" Margin="5" Click="btnPlay_Click"/>
            <Button x:Name="btnPause" Content="Пауза" Width="100" Margin="5" Click="btnPause_Click"/>
            <Button x:Name="btnStop" Content="Стоп" Width="100" Margin="5" Click="btnStop_Click"/>
        </StackPanel>
        <!-- MediaElement для воспроизведения видео -->
        <MediaElement x:Name="mediaElement"
                      Grid.Row="1"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      MediaOpened="mediaElement_MediaOpened"
                      MediaFailed="mediaElement_MediaFailed"/>
        <TextBlock x:Name="txtStatus"
                   Grid.Row="2"
                   FontSize="14"
                   Margin="0,10,0,0"
                   TextAlignment="Center"
                   Text="Статус"/>
    </Grid>
</Window>