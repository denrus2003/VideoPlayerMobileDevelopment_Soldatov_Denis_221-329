<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VideoPlayerNamespace.MainPage">

    <StackLayout>
        <MediaElement x:Name="mediaElement"
                      Source="ваш_видео_файл.mp4"
                      AutoPlay="False"
                      HeightRequest="300"
                      WidthRequest="400" />

        <StackLayout Orientation="Horizontal" HorizontalOptions="Center">
            <Button Text="Воспроизвести" Clicked="OnPlayButtonClicked" />
            <Button Text="Пауза" Clicked="OnPauseButtonClicked" />
            <Button Text="Стоп" Clicked="OnStopButtonClicked" />
        </StackLayout>
    </StackLayout>

</ContentPage>

